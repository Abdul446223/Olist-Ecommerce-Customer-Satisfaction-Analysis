01. ORDERS TABLE -- CHECKS + CLEANING
----------------------------------------------------------------

-- Check: nulls in key columns
SELECT
    COUNT(*) AS total_rows,
    COUNTIF(order_id IS NULL) AS null_order_ids,
    COUNTIF(customer_id IS NULL) AS null_customer_ids,
    COUNTIF(order_status IS NULL) AS null_order_status,
    COUNTIF(order_delivered_customer_date IS NULL) AS null_delivered_date,
    COUNTIF(order_estimated_delivery_date IS NULL) AS null_estimated_date
FROM `OLIST_REVIEWS.Orders`;

-- Check: duplicates on order_id
SELECT
    order_id,
    COUNT(*) AS row_count
FROM `OLIST_REVIEWS.Orders`
GROUP BY order_id
HAVING COUNT(*) > 1;

-- Check: why is order_delivered_customer_date null?
SELECT
    COUNTIF(order_status != 'delivered') AS not_delivered_no_date,
    COUNTIF(order_status = 'delivered') AS delivered_but_no_date
FROM `OLIST_REVIEWS.Orders`
WHERE order_delivered_customer_date IS NULL;

-- Check: canceled orders that still have a delivery date recorded
SELECT
    COUNT(*) AS canceled_with_date
FROM `OLIST_REVIEWS.Orders`
WHERE order_delivered_customer_date IS NOT NULL
  AND order_status = 'canceled';

-- Check: logical consistency (delivered before purchased is impossible)
SELECT
    COUNT(*) AS impossible_dates
FROM `OLIST_REVIEWS.Orders`
WHERE TIMESTAMP_DIFF(order_delivered_customer_date, order_purchase_timestamp, DAY) < 0;

-- Cleaning: keep delivered orders with a valid delivery date, calculate delay_days
-- (positive = late, negative = early)
SELECT
    order_id,
    DATE_DIFF(order_delivered_customer_date, order_estimated_delivery_date, DAY) AS delay_days
FROM `OLIST_REVIEWS.Orders`
WHERE order_delivered_customer_date IS NOT NULL
  AND order_status = 'delivered';
